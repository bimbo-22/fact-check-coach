{
  "manifest_version": 3,
  "name": "Fact-Check Coach",
  "version": "0.2.0",
  "description": "Guess first, then see what named fact-checkers say. A fact-checker that trains you to need it less.",
  "permissions": [
    "contextMenus",
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Fact-Check Coach"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.instagram.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content.css"
      ],
      "matches": [
        "https://www.instagram.com/*"
      ]
    }
  ]
}
