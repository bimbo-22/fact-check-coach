# --- Providers -------------------------------------------------------------
# mock = offline, deterministic (tests + demo).
# ollama = open-source IBM Granite on this machine, free, no key (ollama pull granite4.1:8b)
# ica = IBM Consulting Advantage API (IBM-hosted Granite and others)
# watsonx = IBM Granite in IBM Cloud · anthropic = Claude fallback
LLM_PROVIDER=mock
# mock | google_factcheck | tavily | brave  (tavily/brave also use Google Fact Check if its key is set)
SEARCH_PROVIDER=mock

# IBM Consulting Advantage Developer API (ICA UI → Settings → API Keys → ICA APIs). Starts with lowercase sk-
ICA_API_KEY=
ICA_BASE_URL=https://api.servicesessentials.ibm.com/v1
ICA_MODEL=ibm/granite-4-h-small

# Ollama (local, open-source Granite). From Docker use http://host.docker.internal:11434
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=granite4.1:8b

# IBM watsonx.ai (Granite)
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-3-8b-instruct

# Anthropic fallback
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Search
GOOGLE_FACTCHECK_API_KEY=
TAVILY_API_KEY=
BRAVE_API_KEY=

# --- Telegram bot ------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
# Where the bot reaches the API (docker compose overrides this to http://api:8000)
API_BASE_URL=http://localhost:8000
