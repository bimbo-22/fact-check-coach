# --- Providers -------------------------------------------------------------
# mock = offline, deterministic (tests + demo). Real: watsonx (preferred) or anthropic.
LLM_PROVIDER=mock
# mock | google_factcheck | tavily | brave  (tavily/brave also use Google Fact Check if its key is set)
SEARCH_PROVIDER=mock

# IBM watsonx.ai (Granite)
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-3-8b-instruct

# Anthropic fallback
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Search
GOOGLE_FACTCHECK_API_KEY=
TAVILY_API_KEY=
BRAVE_API_KEY=

# --- Telegram bot ------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
# Where the bot reaches the API (docker compose overrides this to http://api:8000)
API_BASE_URL=http://localhost:8000
